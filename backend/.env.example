# VayuMesh — Backend Environment Variables
APP_ENV=development
APP_NAME=VayuMesh Hyperlocal AQI
DEFAULT_CITY=chikkamagaluru

# Database (PostgreSQL+PostGIS in Docker/Prod, or local SQLite fallback for quick dev)
DATABASE_URL=sqlite+aiosqlite:///./vayumesh_local.db
# DATABASE_URL=postgresql+asyncpg://vayumesh:vayumesh_secret@localhost:5432/vayumesh_aqi

# Redis (optional locally: automatically falls back to in-memory sliding window if unreachable)
REDIS_URL=redis://localhost:6379/0

# Security Secrets (CHANGE IN PRODUCTION)
JWT_SECRET_KEY=replace-with-32-byte-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_PEPPER=replace-with-hmac-sha256-pepper-secret

# Rate Limiting
INGEST_RATE_LIMIT_PER_MIN=12
INGEST_RATE_WINDOW_SEC=60

# External Open APIs (optional keys; Open-Meteo requires no key)
DATA_GOV_API_KEY=
OPENAQ_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
